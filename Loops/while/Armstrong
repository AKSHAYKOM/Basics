#include<iostream>
using namespace std;

int main(){
    int num, a=0, r, temp;

    cout<<"Enter number: ";
    cin>>num;

    temp=num;

    while(num>0)
    {
        r = num % 10;
        a= a *10+r;
        num = num/10;
    }

    if(temp==a)
    {
        cout<<"Armstrong"<<endl;
    } else 
    {
        cout<<"Not Armstrong"<<endl;
    }

    return 0;
}