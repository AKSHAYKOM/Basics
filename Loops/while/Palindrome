#include<iostream>
using namespace std;

int main(){
    int num, a=0, r, n;

    cout<<"Enter number: ";
    cin>>num;

    n=num;

    while(num>0)
    {
        r =num%10;
        a =a*10+r;
        num=num/10;
    }

    if(n==a)
    {
        cout<<"Palindrome"<<endl;
    } else {
        cout<<"Not Palindrome"<<endl;
    }

    return 0;
}